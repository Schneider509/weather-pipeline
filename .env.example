# ==============================================================================
# Configuration de la base de données PostgreSQL locale (Docker)
# ==============================================================================

# Nom d'utilisateur PostgreSQL configuré dans docker-compose.yml
DB_USER=dev_user

# Mot de passe associé à l'utilisateur PostgreSQL
DB_PASSWORD=dev_password

# Hôte de la base de données (utiliser 'localhost' en local)
DB_HOST=localhost

# Port exposé sur votre machine hôte (défaut PostgreSQL : 5432)
DB_PORT=5432

# Nom de la base de données créée dans PostgreSQL
DB_NAME=weather_db